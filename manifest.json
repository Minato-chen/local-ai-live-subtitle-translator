{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "2.1.6",
  "version_name": "2.1.6",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icons/icon-idle-16.png",
    "32": "icons/icon-idle-32.png",
    "48": "icons/icon-idle-48.png",
    "128": "icons/icon-idle-128.png"
  },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.youtube.com/*",
    "https://*.primevideo.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.co.jp/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.disneyplus.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/shared.js", "lib/anki.js", "lib/web-translate.js", "content.js", "web-content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "本地 AI 实时字幕翻译",
    "default_icon": {
      "16": "icons/icon-idle-16.png",
      "32": "icons/icon-idle-32.png",
      "48": "icons/icon-idle-48.png",
      "128": "icons/icon-idle-128.png"
    },
    "default_popup": "popup.html"
  }
}
